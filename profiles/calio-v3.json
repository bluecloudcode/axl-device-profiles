{
  "id": "calio-v3",
  "name": "KSB Calio pump (protocol v3)",
  "vendor": "KSB",
  "version": "1.0.0",
  "description": "KSB Calio smart circulator pump, register map v3.",
  "reads": [
    {
      "key": "b0",
      "fc": 3,
      "address": 2000,
      "quantity": 103,
      "decode": [
        {
          "field": "errorVector",
          "offset": 0,
          "type": "hex"
        },
        {
          "field": "errors",
          "offset": 0,
          "type": "bits",
          "label": "erry",
          "labels": [
            "E01 Temperature limit exceeded",
            "E02 Overcurrent",
            "E03 Internal fault",
            "E04 Rotor blocked",
            "E05 Overload / adjusted speed (warning)",
            "E06 Supply voltage too high/low"
          ]
        },
        {
          "field": "headM",
          "offset": 2,
          "type": "int16",
          "label": "Head",
          "unit": "m",
          "scale": 0.1,
          "decimals": 1
        },
        {
          "field": "flowM3h",
          "offset": 4,
          "type": "int16",
          "label": "Flow",
          "unit": "m3/h",
          "scale": 0.1,
          "decimals": 1
        },
        {
          "field": "speedRpm",
          "offset": 8,
          "type": "uint16",
          "label": "Speed",
          "unit": "rpm"
        },
        {
          "field": "running",
          "offset": 9,
          "type": "bool"
        },
        {
          "field": "operatingHours",
          "offset": 10,
          "type": "uint16",
          "label": "Operating hours",
          "unit": "h"
        },
        {
          "field": "powerW",
          "offset": 12,
          "type": "int16",
          "label": "Power",
          "unit": "W"
        },
        {
          "field": "loadPct",
          "offset": 14,
          "type": "uint16",
          "label": "Load",
          "unit": "%"
        },
        {
          "field": "mode",
          "offset": 100,
          "type": "enum",
          "label": "Operating mode",
          "enum": {
            "1": "Constant pressure",
            "4": "Proportional pressure",
            "8": "Eco mode",
            "16": "Fixed speed"
          }
        },
        {
          "field": "setpointPct",
          "offset": 101,
          "type": "uint16",
          "label": "Setpoint",
          "unit": "%",
          "scale": 0.010001,
          "decimals": 1
        },
        {
          "field": "startStop",
          "offset": 102,
          "type": "enum",
          "label": "Start/stop",
          "enum": {
            "5": "stopped",
            "160": "running"
          }
        }
      ]
    },
    {
      "key": "b1",
      "fc": 3,
      "address": 3000,
      "quantity": 2,
      "decode": [
        {
          "field": "baudRate",
          "offset": 0,
          "type": "uint16",
          "label": "Baud rate"
        },
        {
          "field": "modbusAddress",
          "offset": 1,
          "type": "uint16",
          "label": "Modbus address"
        }
      ]
    }
  ],
  "commands": {
    "mode": {
      "fc": 16,
      "address": 2100,
      "field": "mode"
    },
    "setpoint": {
      "fc": 16,
      "address": 2101,
      "field": "setpointPct",
      "label": "Setpoint",
      "scale": 99.99,
      "min": 0,
      "max": 100
    },
    "start": {
      "fc": 16,
      "address": 2102,
      "label": "Start"
    }
  }
}
